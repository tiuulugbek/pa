// Power Automation — Prisma schema
// PostgreSQL backed. All user-facing string fields are stored as Uz/Ru pairs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id        Int        @id @default(autoincrement())
  nameUz    String
  nameRu    String
  nameEn    String?
  slug      String     @unique
  icon      String? // SVG string or icon name
  parentId  Int?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  order     Int        @default(0)
  createdAt DateTime   @default(now())
}

model Brand {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  logo      String? // /uploads/brands/logo.png
  country   String?
  website   String?
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id             Int       @id @default(autoincrement())
  nameUz         String
  nameRu         String
  nameEn         String?
  slug           String    @unique
  descriptionUz  String?   @db.Text
  descriptionRu  String?   @db.Text
  descriptionEn  String?   @db.Text
  categoryId     Int
  category       Category  @relation(fields: [categoryId], references: [id])
  brandId        Int?
  brand          Brand?    @relation(fields: [brandId], references: [id])
  images         String[] // ["/uploads/products/img1.jpg"]
  documents      Json? // [{name, url}]
  specifications Json? // [{label, value}]
  certificates   String[] // ["ATEX", "IECEx", "GOST"]
  industries     String[] // ["oil_gas", "chemical", "mining"]
  badge          String? // "Yangi" | "Ko'p buyurilgan" | "Sertifikatlangan"
  views          Int       @default(0)
  isActive       Boolean   @default(true)
  isFeatured     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  inquiries      Inquiry[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive, isFeatured])
  @@index([isActive, createdAt])
}

model Inquiry {
  id               Int           @id @default(autoincrement())
  productId        Int?
  product          Product?      @relation(fields: [productId], references: [id])
  telegramUserId   String?
  telegramUsername String?
  name             String?
  phone            String?
  company          String?
  message          String        @db.Text
  status           InquiryStatus @default(NEW)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model NewsPost {
  id          Int       @id @default(autoincrement())
  titleUz     String
  titleRu     String
  titleEn     String?
  slug        String    @unique
  bodyUz      String    @db.Text
  bodyRu      String    @db.Text
  bodyEn      String?   @db.Text
  thumbnail   String?
  category    String? // "Yangilik" | "Texnik maqola" | "Loyiha"
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([isPublished, publishedAt])
}

model Project {
  id          Int      @id @default(autoincrement())
  titleUz     String
  titleRu     String
  titleEn     String?
  slug        String   @unique
  descUz      String   @db.Text
  descRu      String   @db.Text
  descEn      String?  @db.Text
  industry    String // "oil_gas" | "chemical" | "mining" | "energy"
  location    String?
  year        Int?
  images      String[]
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([isPublished, industry])
}

model AdminUser {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String // bcrypt hash
  createdAt DateTime @default(now())
}

enum InquiryStatus {
  NEW
  SEEN
  REPLIED
}
