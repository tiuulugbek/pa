{
  "name": "power-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Power Automation MCHJ — B2B industrial equipment catalog (monorepo)",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "gen:images": "node scripts/generate-images.mjs",
    "db:generate": "pnpm --filter @pa/db generate",
    "db:migrate": "pnpm --filter @pa/db migrate",
    "db:seed": "pnpm --filter @pa/db seed",
    "db:push": "pnpm --filter @pa/db push"
  },
  "pnpm": {
    "overrides": {
      "file-type": "21.3.2",
      "form-data": "4.0.6",
      "lodash": "4.18.0",
      "multer": "2.2.0",
      "postcss": "8.5.10",
      "qs": "6.15.2"
    }
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "turbo": "^2.10.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
