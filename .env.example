# Copy to .env and replace every CHANGE_ME value before deployment.
# Never commit the real .env file.

DATABASE_URL=postgresql://pa_user:CHANGE_ME_DB_PASSWORD@postgres:5432/power_automation_db
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

TELEGRAM_BOT_TOKEN=CHANGE_ME_TELEGRAM_BOT_TOKEN
ADMIN_CHAT_ID=CHANGE_ME_ADMIN_CHAT_ID
NEXT_PUBLIC_TELEGRAM_BOT=@power_automation_bot

MEILI_URL=http://meilisearch:7700
MEILI_KEY=CHANGE_ME_LONG_RANDOM_MEILI_KEY
REDIS_URL=redis://redis:6379

JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARACTER_RANDOM_SECRET
JWT_EXPIRES_IN=2h
JWT_ISSUER=power-automation-api
JWT_AUDIENCE=power-automation-admin

# Comma-separated browser origins allowed to call the API with credentials.
CORS_ORIGINS=https://powerautomation.uz,https://www.powerautomation.uz,https://admin.powerautomation.uz

# Public browser-facing API origin.
NEXT_PUBLIC_API_URL=https://api.powerautomation.uz

# Internal Docker-network API origin used by SSR/ISR.
API_INTERNAL_URL=http://api:3001

# Optional analytics identifier.
NEXT_PUBLIC_GA_ID=

NODE_ENV=production
PORT=3001
